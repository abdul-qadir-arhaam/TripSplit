# Environment
ENVIRONMENT=development
PROJECT_NAME="Trip Finance"

# Database (PostgreSQL for prod/docker, SQLite fallback for zero-dependency local dev)
DATABASE_URL=sqlite:///./trip_finance.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trip_finance

# Security & JWT
SECRET_KEY=supersecretkeychangethisinproduction1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
